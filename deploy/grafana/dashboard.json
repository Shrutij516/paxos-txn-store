{
  "title": "paxos-txn-store",
  "uid": "paxos-txn-store",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "tags": [
    "paxos-txn-store"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Leader elections",
      "description": "Elections won per shard in the last minute (increase of paxos_leader_elections_total). Flat at zero when leaders are stable; a spike means a leader died or was cut off.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (shard) (increase(paxos_leader_elections_total[1m]))",
          "legendFormat": "shard {{shard}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Commit latency p50 / p99",
      "description": "Time from a leader proposing a log entry to applying it, per shard (paxos_commit_latency_seconds).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, shard) (rate(paxos_commit_latency_seconds_bucket[1m])))",
          "legendFormat": "p50 shard {{shard}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, shard) (rate(paxos_commit_latency_seconds_bucket[1m])))",
          "legendFormat": "p99 shard {{shard}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Throughput",
      "description": "Committed transactions per second across the cluster, and the cross-shard part (txn_commits_total, txn_cross_shard_commits_total).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(rate(txn_commits_total[1m]))",
          "legendFormat": "all commits"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "sum(rate(txn_cross_shard_commits_total[1m]))",
          "legendFormat": "cross-shard commits"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Abort rate by reason",
      "description": "Aborted transactions per second, one series per reason (the txn_aborts_<reason>_total counters).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (__name__) (rate({__name__=~\"txn_aborts_.+_total\"}[1m]))",
          "legendFormat": "{{__name__}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "In-doubt transactions",
      "description": "Prepared transactions waiting for an outcome, per shard (max of txn_in_doubt over the replicas). Should drop back to 0 within an in-doubt wait after a coordinator failure.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "max by (shard) (txn_in_doubt)",
          "legendFormat": "shard {{shard}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "fsync latency p50 / p99",
      "description": "Duration of each durable storage write per node (storage_fsync_seconds).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, node) (rate(storage_fsync_seconds_bucket[1m])))",
          "legendFormat": "p50 node {{node}}"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, node) (rate(storage_fsync_seconds_bucket[1m])))",
          "legendFormat": "p99 node {{node}}"
        }
      ]
    }
  ]
}
